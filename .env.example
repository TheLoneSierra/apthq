# API base URL (leave empty in dev — Vite proxy handles /api and /health)
VITE_API_BASE=

# Dev proxy targets (vite.config.ts only, not exposed to client)
# 1. Analytics & Health Lambda proxy target:
VITE_API_PROXY_TARGET=https://oc5l6dayoesmq6w5gi7nzeefqm0mvfwu.lambda-url.ap-south-1.on.aws

# 2. Brand Config / Login (/v2) — Apt demo API (default). For local mock data use http://localhost:3000 + npm run server
# 2. Brand Config / Login (/v2/aggregate, /v2/users/login)
# Local default: mock server on port 3000 (run `npm run server` in a second terminal) — same as Vercel deploy.
# Set VITE_BRAND_CONFIG_USE_APTDEMO=true to hit real aptdemo instead (needs session_token cookie).
VITE_BRAND_CONFIG_MOCK_TARGET=http://localhost:3000

# Other /v2 routes (if any) — aptdemo
VITE_V2_PROXY_TARGET=https://api.aptdemo.atoms.trade

# 3. Health Check v3 proxy target for /v3 (default: https://api.aptdemo.atoms.trade)
VITE_HEALTH_V3_PROXY_TARGET=https://api.aptdemo.atoms.trade

# Optional: override full v3 API base (leave empty to use same-origin /v3 proxy)
VITE_HEALTH_V3_API_BASE=

# Optional: session_token UUID for Brand Config tab (paste in UI is easier)
# VITE_BRAND_CONFIG_TOKEN=
