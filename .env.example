# Leave empty on Vercel — same-origin requests are routed by vercel.json
# Set only if you need direct cross-origin calls to a single backend URL
VITE_API_BASE=

# Dev proxy: analytics Lambda (vite.config.ts only)
VITE_API_PROXY_TARGET=https://oc5l6dayoesmq6w5gi7nzeefqm0mvfwu.lambda-url.ap-south-1.on.aws

# Dev proxy: brand config backend — run `npm run server` (port 3000)
VITE_BRAND_API_PROXY_TARGET=http://localhost:3000

# Optional: default access token for Brand Config tab
VITE_BRAND_CONFIG_TOKEN=
